# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Database
MONGODB_URI=mongodb://localhost:27017/naat-app
MONGODB_TEST_URI=mongodb://localhost:27017/naat-app-test

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_REFRESH_EXPIRE=30d

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS S3 (or MinIO alternative)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=naat-app-uploads
AWS_S3_URL=https://naat-app-uploads.s3.amazonaws.com

# MinIO Configuration (if using MinIO instead of S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=naat-app-uploads

# AI Engine Configuration
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=your_ai_engine_api_key

# FFmpeg Path
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# File Upload Configuration
MAX_FILE_SIZE=524288000
MAX_REQUEST_SIZE=524288000
UPLOAD_TEMP_DIR=./uploads/temp
PROCESSED_OUTPUT_DIR=./uploads/processed

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@naat-app.com

# Stripe (Payment Gateway - optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Sentry (Error Tracking - optional)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Socket.IO Configuration
SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_PING_TIMEOUT=60000

# Processing Configuration
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT=3600000
PROCESSING_QUALITY=high

# Application
APP_NAME=Naat-App
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
